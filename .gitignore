# Per-machine runtime state — regenerated on each computer, never shared.
# The whole folder: it now also holds settings.ini (with the DPAPI-wrapped
# OpenRouter key — must never be committed) and AI draft scratch files.
logs/

# Personal AI-action prompts — user content, like personal macros.
prompts/

# MCP server (optional add-on) — Python venv and caches are per-machine.
mcp/.venv/
__pycache__/
*.pyc

# Distribution build artifacts (bundled installer zip/exe) — generated, not source.
dist/

# Personal automations — per-machine user content (macros, workflow steps/sheets,
# hotkey modules). gitignore only applies to UNTRACKED files, so VoiceKit's own
# committed files in these folders are unaffected and keep diffing normally.
# To add a genuinely new shipped file to the repo, use `git add -f <path>`.
macros/*.ahk
workflows/
hotkeys/*.ahk
